{
  "name": "nexa-playwright-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1 --port 4174\" \"tsx server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "playwright:install": "playwright install chromium firefox webkit",
    "allure:report": "allure generate allure-results --clean -o allure-report"
  },
  "dependencies": {
    "@emotion/react": "latest",
    "@emotion/styled": "latest",
    "@mui/material": "latest",
    "axios": "latest",
    "chart.js": "latest",
    "express": "latest",
    "react": "latest",
    "react-chartjs-2": "latest",
    "react-dom": "latest",
    "socket.io": "latest",
    "socket.io-client": "latest",
    "xlsx": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "allure-commandline": "latest",
    "allure-playwright": "latest",
    "concurrently": "latest",
    "playwright": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}